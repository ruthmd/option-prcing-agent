# .env

# ── Provider Selection ────────────────────────────────────────────────
# Options: local | openai | claude
LLM_PROVIDER=claude

# ── LLM-as-Judge (independent grounding check) ─────────────────────────
# Options: local | openai | claude | none (disables the check entirely)
# Keep this different from LLM_PROVIDER so the judge is a genuine second opinion
LLM_JUDGE=openai

# ── Local (Ollama) ────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── OpenAI ────────────────────────────────────────────────────────────
OPENAI_API_KEY=<your-openai-api-key-here>
OPENAI_MODEL=gpt-4o

# ── Anthropic (Claude) ────────────────────────────────────────────────
ANTHROPIC_API_KEY=<your-anthropic-api-key-here>
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Market Data ───────────────────────────────────────────────────────
YFINANCE_TIMEOUT=30
CACHE_DURATION_MINUTES=5
RISK_FREE_RATE_TICKER=^TNX
DEFAULT_RISK_FREE_RATE=0.05

# ── Vector Store ──────────────────────────────────────────────────────
FAISS_INDEX_PATH=data/knowledge_base/faiss_index
KNOWLEDGE_BASE_PATH=data/knowledge_base

# ── Risk Management ───────────────────────────────────────────────────
MAX_VOLATILITY=3.0
MIN_VOLATILITY=0.01
MAX_INTEREST_RATE=0.20
MIN_STOCK_PRICE=0.01

# ── Validation ────────────────────────────────────────────────────────
DOMAIN_RELEVANCE_THRESHOLD=0.7
CONFIDENCE_THRESHOLD=0.8
MAX_STRIKE_DEVIATION=0.5
MAX_DAYS_TO_EXPIRY=1095

# ── API Server ────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000